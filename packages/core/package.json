{
  "name": "aeyes-local-agent",
  "version": "0.1.0",
  "description": "AeyeStudio 내 PC 연결용 로컬 MCP 에이전트",
  "license": "MIT",
  "type": "module",
  "bin": {
    "aeyes-local-agent": "dist/cli.js"
  },
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "LICENSE"
  ],
  "engines": {
    "node": ">=20"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "prepublishOnly": "pnpm build"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.26.0",
    "clipboardy": "^5.3.2",
    "exceljs": "^4.4.0",
    "mysql2": "^3.24.4",
    "open": "^11.0.4",
    "pg": "^8.23.0",
    "trash": "^10.1.1",
    "zod": "^4.1.0"
  },
  "optionalDependencies": {
    "@nut-tree-fork/nut-js": "^4.2.6",
    "screenshot-desktop": "^1.15.6"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "typescript": "^5.8.0",
    "vitest": "^4.1.0"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/AEyesTech/aeyes-local-agent.git",
    "directory": "packages/core"
  },
  "homepage": "https://github.com/AEyesTech/aeyes-local-agent#readme"
}
